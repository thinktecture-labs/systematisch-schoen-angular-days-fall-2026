{
  "source": [
    "tokens/ref/*.json",
    "tokens/sys/*.json",
    "tokens/sys/color/light.json",
    "tokens/comp/*.json"
  ],
  "platforms": {
    "css": {
      "transformGroup": "css",
      "transforms": ["size/pxToRem"],
      "prefix": "md",
      "buildPath": "projects/ui/src/lib/styles/tokens/",
      "files": [
        {
          "destination": "tokens.css",
          "format": "css/variables"
        }
      ]
    }
  }
}
